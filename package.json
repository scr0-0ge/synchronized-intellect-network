{
  "name": "synchronized-intellect-network",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#workbench-f104-production": "./src/workbench-shell/f104-production-acceptance.ts"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "test": "node --test --test-concurrency=1 --test-isolation=process --test-timeout=120000 tests/agent-runtime/*.test.ts tests/session-profile/*.test.ts tests/coordinator/*.test.ts tests/workbench-shell/*.test.ts tests/harness/*.test.ts tests/e2e/*.test.ts tests/launcher/*.test.mjs",
    "test:rendered-surfaces": "node --test --test-concurrency=1 --test-isolation=process --test-timeout=120000 tests/quarantine/*.test.ts",
    "test:e2e": "node --no-warnings tests/e2e/electron-e2e.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.renderer.json",
    "workbench:qa:build": "vite build --config vite.qa.config.ts",
    "workbench:qa:serve": "vite preview --config vite.qa.config.ts",
    "workbench:package:windows": "pnpm build && node scripts/package-workbench-windows.ts",
    "workbench:start": "pnpm build && electron .",
    "validate:codex-catalog": "node --no-warnings scripts/validate-codex-catalog.ts",
    "validate:claude-deployment": "node --no-warnings scripts/validate-claude-deployment.ts",
    "validate:workbench-catalog": "node --no-warnings scripts/validate-workbench-catalog.ts",
    "validate:workbench-live": "node --no-warnings scripts/validate-workbench-live.ts"
  },
  "dependencies": {
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@electron/packager": "20.0.4",
    "@types/node": "22.15.30",
    "electron": "37.2.6",
    "playwright": "1.62.1",
    "typescript": "^5.9.3",
    "vite": "7.0.6",
    "vite-plugin-solid": "2.11.8"
  }
}
